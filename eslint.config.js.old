      ".next/**/*",
      "node_modules/**/*",
      "dist/**/*",
      "build/**/*",
      "*.config.js",
      "*.config.mjs",
    ],
  },
  // ─── NEXT.JS STANDARD KONFIGURATION LADEN ────────────────────
