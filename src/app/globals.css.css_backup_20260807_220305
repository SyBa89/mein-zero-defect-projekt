@tailwind base;
@tailwind components;
@tailwind utilities;

/* ═══════════════════════════════════════════════════════════════════════
   ✅ ZERO-DEFECT THEME SYSTEM - Vollständige CSS-Variablen
   Alle Tailwind-Referenzen (bg-card, border-border etc.) sind hier definiert
   ═══════════════════════════════════════════════════════════════════════ */

@layer base {
  :root {
    /* ── Core Colors (Light Mode) ── */
    --background: 0 0% 100%;
    --foreground: 222.2 84% 4.9%;
    --card: 0 0% 100%;
    --card-foreground: 222.2 84% 4.9%;
    --popover: 0 0% 100%;
    --popover-foreground: 222.2 84% 4.9%;
    --primary: 330 81% 60%;
    --primary-foreground: 210 40% 98%;
    --secondary: 262 83% 58%;
    --secondary-foreground: 210 40% 98%;
    --muted: 210 40% 96.1%;
    --muted-foreground: 215.4 16.3% 46.9%;
    --accent: 210 40% 96.1%;
    --accent-foreground: 222.2 47.4% 11.2%;
    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 210 40% 98%;
    --border: 214.3 31.8% 91.4%;
    --input: 214.3 31.8% 91.4%;
    --ring: 330 81% 60%;
    --radius: 0.75rem;
    --theme-color: #ec4899;
  }

  .dark {
    /* ── Core Colors (Dark Mode) ── */
    --background: 222.2 84% 4.9%;
    --foreground: 210 40% 98%;
    --card: 222.2 84% 4.9%;
    --card-foreground: 210 40% 98%;
    --popover: 222.2 84% 4.9%;
    --popover-foreground: 210 40% 98%;
    --primary: 330 81% 60%;
    --primary-foreground: 210 40% 98%;
    --secondary: 262 83% 58%;
    --secondary-foreground: 210 40% 98%;
    --muted: 217.2 32.6% 17.5%;
    --muted-foreground: 215 20.2% 65.1%;
    --accent: 217.2 32.6% 17.5%;
    --accent-foreground: 210 40% 98%;
    --destructive: 0 62.8% 30.6%;
    --destructive-foreground: 210 40% 98%;
    --border: 217.2 32.6% 17.5%;
    --input: 217.2 32.6% 17.5%;
    --ring: 330 81% 60%;
  }
}

@layer base {
  * {
    @apply border-border;
  }
  body {
    @apply bg-background text-foreground antialiased;
    font-feature-settings: "rlig" 1, "calt" 1;
  }
}

/* ═══════════════════════════════════════════════════════════════════════
   ✅ ZERO-DEFECT COMPONENTS
   ═══════════════════════════════════════════════════════════════════════ */

@layer components {
  /* Glassmorphism Card */
  .glass-card {
    @apply bg-white/70 dark:bg-gray-900/70 backdrop-blur-xl border border-white/20 dark:border-gray-700/30;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
  }

  /* Generic Card */
  .card {
    @apply bg-card text-card-foreground rounded-xl shadow-sm border border-border;
  }

  /* Skip-Link für Accessibility (WCAG 2.2) */
  a.skip-link {
    position: absolute !important;
    top: -100px !important;
    left: 6px !important;
    background: #db2777 !important;
    color: white !important;
    padding: 0.75rem 1.5rem !important;
    border-radius: 0.5rem !important;
    font-weight: 600 !important;
    z-index: 9999 !important;
    transition: top 0.2s ease-out !important;
    text-decoration: none !important;
  }

  a.skip-link:focus {
    top: 6px !important;
    outline: 3px solid #ec4899 !important;
    outline-offset: 2px !important;
  }

  /* Gradient Text Utility */
  .gradient-text {
    @apply bg-gradient-to-r from-pink-600 to-purple-600 dark:from-pink-400 dark:to-purple-400 bg-clip-text text-transparent;
  }

  /* Pulse Glow für Live-Status */
  .pulse-glow {
    animation: pulse-glow 2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Smooth Scroll */
  html {
    scroll-behavior: smooth;
  }

  /* Focus Styles */
  :focus-visible {
    @apply outline-none ring-2 ring-pink-500 ring-offset-2 ring-offset-background;
  }
}

/* ═══════════════════════════════════════════════════════════════════════
   ✅ ZERO-DEFECT UTILITIES
   ═══════════════════════════════════════════════════════════════════════ */

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }

  .animate-fade-in {
    animation: fade-in 0.5s ease-out;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Reduced Motion - Respect User Preferences */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
}
/* ═══════════════════════════════════════════════════════════════
   Industry-Specific Design System — CSS Variables (auto-injected)
   ═══════════════════════════════════════════════════════════════ */

:root {
  --color-primary: #E91E63;
  --color-secondary: #FFC107;
  --color-accent: #4CAF50;
  --color-background: #FAFAFA;
  --color-surface: #FFFFFF;
  --color-text: #212121;
  --color-text-secondary: #616161;
  --color-border: #E0E0E0;
  --font-heading: 'Poppins', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-mono: 'Fira Code', monospace;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  --radius-sm: 0.125rem;
  --radius-md: 0.375rem;
  --radius-lg: 0.5rem;
  --radius-xl: 0.75rem;
  --duration-fast: 150ms;
  --duration-normal: 300ms;
  --duration-slow: 500ms;
}

body {
  transition: background-color 0.3s ease, color 0.3s ease;
  font-family: var(--font-body);
  color: var(--color-text);
  background-color: var(--color-background);
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
}

code, pre {
  font-family: var(--font-mono);
}

.text-theme-primary { color: var(--color-primary) !important; }
.bg-theme-primary { background-color: var(--color-primary) !important; }
.border-theme-primary { border-color: var(--color-primary) !important; }
.shadow-theme-md { box-shadow: var(--shadow-md) !important; }
