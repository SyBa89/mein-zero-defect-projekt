# =========================================================
# ZERO-DEFECT PROJEKT - Environment Variables
# Kopiere diese Datei als .env.local und trage deine echten Werte ein
# =========================================================

# ────────────────────────────────────────────────────────────
# 🌐 PUBLIC (Client-seitig, NEXT_PUBLIC_*)
# ────────────────────────────────────────────────────────────

# White-Label Tenant-ID (kiosk | craftsman | medical | restaurant | friseur)
NEXT_PUBLIC_TENANT_ID=kiosk

# Sentry DSN für Client-Error-Reporting (optional, leer lassen lokal)
NEXT_PUBLIC_SENTRY_DSN=

# ────────────────────────────────────────────────────────────
# 🔒 PRIVATE (Server-seitig, NIEMALS committen!)
# ────────────────────────────────────────────────────────────

# ─── Authentication ───
# JWT Secret (min. 32 Zeichen, generiere mit: openssl rand -base64 32)
JWT_SECRET=

# Admin-Bootstrap-Passwort (nur für initiales Setup)
INTERN_PASSWORD=

# ─── Upstash Redis (KV + Rate-Limiting) ───
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Legacy/Alternative (Upstash bietet mehrere Formate, meist nicht benötigt)
# KV_URL=
# REDIS_URL=

# ─── Resend (Email-Versand) ───
RESEND_API_KEY=

# ─── Sentry (Error-Monitoring, Server + Edge) ───
SENTRY_DSN=
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=

# ─── Vercel Edge Config (Feature-Flags, optional) ───
EDGE_CONFIG=

# ─── System (wird automatisch gesetzt, nicht manuell eintragen) ───
# CI=true  (GitHub Actions setzt das automatisch)